{
    "name": "vpndetection/symfony",
    "description": "Official Symfony bundle for the VPNDetection API. Detect VPNs, proxies, Tor, hosting and CDN visitors on every request.",
    "keywords": ["symfony", "bundle", "vpn", "vpn-detection", "proxy-detection", "tor", "ip-intelligence", "fraud-prevention"],
    "homepage": "https://vpndetection.io",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "vpndetection/vpndetection": "^4.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "symfony/event-dispatcher": "^7.0"
    },
    "autoload": { "psr-4": { "VPNDetection\\Symfony\\": "src/" } },
    "autoload-dev": { "psr-4": { "VPNDetection\\Symfony\\Tests\\": "tests/" } },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
